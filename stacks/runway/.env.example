# Runway's settings, passed whole to its three containers. The image already sets
# APP_ENV=production, DB_CONNECTION=sqlite, DB_DATABASE and OCTANE_SERVER. The Opusline URL
# and token and the Anthropic API key are not here: they are entered in Runway's Réglages page.
# The values below are what scripts/edit_env.sh starts a new file with.

APP_NAME=Runway
# `sudo docker run --rm ghcr.io/androlax2/runway:<version> php artisan key:generate --show`
# (README, Runway). Keep a copy in Vaultwarden: it encrypts the cookies and whatever the app
# stores encrypted, which is lost with it. To change it, move the old one to APP_PREVIOUS_KEYS.
APP_KEY=
APP_PREVIOUS_KEYS=
# Must stay false: Laravel's debug pages print the environment, secrets included.
APP_DEBUG=false
# https://runway.<PROXY_DOMAIN>. Links, the PWA and Enable Banking's redirect are built on it.
APP_URL=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
# To Docker's log, which Dozzle shows and x-logging rotates. Laravel's default writes to
# storage/logs inside the container, which is not mounted: gone on every update.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
# The app is only reached over HTTPS, through the proxy.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Who may send X-Forwarded-*. Traefik reaches the app on its LAN port from a Docker bridge
# address, never the same one: 172.16.0.0/12 is the range Docker gives its networks. Without
# it, Laravel takes the requests for plain HTTP and builds http:// links (README, Runway).
TRUSTED_PROXIES=172.16.0.0/12

# The mail server the alerts are sent through. MAIL_SCHEME null: STARTTLS on 587.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Runway

# The Enable Banking application's ID (its control panel). Its private key is the file
# ${DOCKERCONFDIR}/runway/secrets/enable-banking.pem, readable by uid 1000 only.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/app/secrets/enable-banking.pem

# Web Push keys: `sudo docker run --rm ghcr.io/androlax2/runway:<version> php artisan push:vapid`,
# once. A new pair drops every push subscription: each device must switch push on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:<your address>, which push services may write to
VAPID_SUBJECT=

# Spelled out, not left empty: an empty value reaches Laravel as "", not as the app's default.
ANTHROPIC_MODEL=claude-opus-5-5
