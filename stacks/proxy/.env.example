# Tailscale auth key (admin console, Settings > Keys). Used once: the node then keeps its
# identity in ${DOCKERCONFDIR}/tailscale. Disable key expiry on the node afterwards.
TS_AUTHKEY=
# Domain the routes are served under, without a subdomain, e.g. example.com
PROXY_DOMAIN=
# Address Let's Encrypt warns when a certificate is about to expire
ACME_EMAIL=
# OVH API credentials for the certificate's DNS challenge. Endpoint: ovh-eu or ovh-ca.
# Rights: POST and DELETE on /domain/zone/* (or on /domain/zone/<domain>/* to limit the token
# to that zone).
OVH_ENDPOINT=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# OVH DynHost identifier allowed to update the plex record (OVH control panel, the domain's
# DynHost tab, where the plex record itself must be a DynHost one). No " or \ in the password.
OVH_DYNHOST_USERNAME=
OVH_DYNHOST_PASSWORD=
# Opusline's host port: HTTP_PORT in stacks/opusline/.env, 8790 when that one is empty.
# Required: the stack refuses to start without it.
OPUSLINE_PORT=
