# Tailscale auth key (admin console, Settings > Keys). Used once: the node then keeps its
# identity in ${DOCKERCONFDIR}/tailscale. Disable key expiry on the node afterwards.
TS_AUTHKEY=
# Address Let's Encrypt warns when a certificate is about to expire
ACME_EMAIL=
# Cloudflare API token with Zone:Read and DNS:Edit on the domain's zone: a user token (My Profile >
# API Tokens) or an account-owned one (the account's API Tokens page). Traefik's certificate
# challenge and ddns-updater's plex record both use it. Required: the stack refuses to start
# without it.
CLOUDFLARE_DNS_API_TOKEN=
# Zone ID of the domain (dashboard, the domain's Overview page). Required.
CLOUDFLARE_ZONE_ID=
# Opusline's host port: HTTP_PORT in stacks/opusline/.env, 8790 when that one is empty.
# Required: the stack refuses to start without it.
OPUSLINE_PORT=
