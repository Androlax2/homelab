# Dashboard login (Glance). Generate the values with the Glance image (see README):
# the secret with `secret:make`, the hash with `password:hash <password>`.
# Single-quote the hash: it contains $ signs.
GLANCE_SECRET_KEY=
GLANCE_USERNAME=
GLANCE_PASSWORD_HASH=

# Services the dashboard reads, as host:port without http:// (the widgets add it), e.g. 192.168.1.10:8989
TAUTULLI_URL=
IMMICH_URL=
PROWLARR_URL=
SONARR_URL=
RADARR_URL=
# Where the dashboard's Vaultwarden link opens: the same value as in stacks/security/.env
VAULTWARDEN_DOMAIN=

# API keys, from each app's settings
TAUTULLI_API_KEY=
IMMICH_API_KEY=
SEERR_API_KEY=
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=

# Storage Box widget: a Read-only API token from Hetzner Console (Security > API tokens, in the
# project holding the Storage Box), and the Storage Box's ID, listed by
# curl -H "Authorization: Bearer <token>" https://api.hetzner.com/v1/storage_boxes
HETZNER_API_TOKEN=
HETZNER_STORAGE_BOX_ID=

# Folder Filebrowser shows and can modify. Keep it as narrow as possible: never a folder
# holding app databases, or this repo (its .env files hold every secret).
FILEBROWSER_ROOT=

# Beszel agent: the hub's public key and a token, both shown in the hub once it runs (see
# README, Monitoring). Empty on the first deploy. Double-quote the key: it contains a space.
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

# Mail server Gatus sends its alerts through, and the address that receives them. Host, port,
# from and to are required: the stack refuses to start without them. An empty username means
# the from address, an empty password no authentication.
# From: an address the mail server lets this login send as. No " or \ in the password.
GATUS_SMTP_HOST=
GATUS_SMTP_PORT=
GATUS_SMTP_USERNAME=
GATUS_SMTP_PASSWORD=
GATUS_SMTP_FROM=
GATUS_ALERT_TO=
# Opusline's host port, which Gatus checks: the same value as in stacks/proxy/.env.
# Required: the stack refuses to start without it.
OPUSLINE_PORT=
