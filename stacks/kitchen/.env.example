# Public URL of the recipe browser, reverse proxy included, e.g. https://cook.example.com
# Used for the dashboard link. CookCLI checks that the browser's Origin matches the host
# it is reached on before accepting the "new recipe" form, so this must be the address
# you actually open (a 403 when saving a new recipe means they disagree).
COOKLANG_URL=

# Login asked for by the gateway in front of CookCLI, which has no authentication of its
# own and whose API can delete recipe files. Generate the hash with:
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --algorithm bcrypt --plaintext '<password>'
# Single-quote the hash: it contains $ signs.
COOKLANG_USERNAME=
COOKLANG_PASSWORD_HASH=
