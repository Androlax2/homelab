# Vaultwarden admin page token, stored as an Argon2 hash. Generate it with
#   docker exec -it vaultwarden /vaultwarden hash
# and single-quote it here (it contains $ signs). Leave it empty to disable /admin.
VAULTWARDEN_ADMIN_TOKEN=
# URL the clients use, the one config/traefik/routes.yml serves, e.g. https://vault.example.com
# Open the vault on this address only: attachments fail to download from any other.
VAULTWARDEN_DOMAIN=

# Mail server Vaultwarden sends through (verification codes, invitations). All six are required.
# Security: starttls (usually port 587) or force_tls (usually port 465).
# From: an address the mail server lets this login send as. A value that is not an email
# address stops Vaultwarden from starting.
VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_PORT=
VAULTWARDEN_SMTP_SECURITY=
VAULTWARDEN_SMTP_USERNAME=
VAULTWARDEN_SMTP_PASSWORD=
VAULTWARDEN_SMTP_FROM=
