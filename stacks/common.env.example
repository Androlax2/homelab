# Server-wide values shared by every stack. The real file is stacks/common.env on the
# server (never committed); edit it with scripts/edit_env.sh common.

# Host folder for app config and databases, e.g. /volume1/docker/appdata
DOCKERCONFDIR=
# Host folder for media, downloads and photo libraries, e.g. /volume1/data
DOCKERSTORAGEDIR=
# Host folder for the nightly database backups (scripts/backup_databases.sh), e.g. /volume1/backup/databases
BACKUPDIR=
# Log rotation for every container: number of files and size of each, e.g. 3 and 10m
DOCKERLOGGING_MAXFILE=
DOCKERLOGGING_MAXSIZE=
# Time zone, e.g. Europe/Paris
TZ=
# User and group that own the app files: `id <user>` on the server
PUID=
PGID=
# The server's LAN address, which the proxy and the dashboard reach the apps on, e.g. 192.168.1.10
LAN_IP=
# Domain the proxy serves the apps under (https://<app>.<domain>), without a subdomain,
# e.g. example.com. Every stack needs it: the dashboard's links use these addresses.
PROXY_DOMAIN=
# Ping URLs of the two healthchecks.io checks (https://hc-ping.com/<uuid>) that scripts/deploy.sh
# and scripts/backup_nas.sh call when they succeed: healthchecks.io alerts when the pings stop,
# which is the one alert that still leaves when the server is off. Both are required.
DEPLOY_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
