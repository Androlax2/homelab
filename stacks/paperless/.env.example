# The first deploy generates the first two (operations/2026_10_10_172231_prepare_the_paperless_stack.before.sh)
# and sets the third to a folder it creates. All three are required.

# Signs the sessions. Changing it logs everyone out.
PAPERLESS_SECRET_KEY=
# Password of Paperless's Postgres database. Postgres only takes it when it creates the
# database: changing it here afterwards locks Paperless out.
PAPERLESS_DB_PASSWORD=
# The inbox: Paperless imports every file dropped in this folder, then deletes it from there.
# A shared folder of the NAS lets a computer or a scanner drop files into it, e.g.
# /volume1/paperless-inbox. The folder must exist, and the user PUID must be able to write in it.
PAPERLESS_CONSUME_DIR=
