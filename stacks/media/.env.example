# Deluge VPN (binhex/arch-delugevpn): see the image's documentation for accepted values
VPN_ENABLED=
VPN_USER=
VPN_PASS=
VPN_PROV=
VPN_CLIENT=
VPN_OPTIONS=
STRICT_PORT_FORWARD=
ENABLE_PRIVOXY=
# LAN range allowed to reach Deluge outside the VPN, e.g. 192.168.1.0/24
LAN_NETWORK=
# Comma-separated DNS servers used inside the VPN container, e.g. 1.1.1.1,9.9.9.9
NAME_SERVERS=
DELUGE_DAEMON_LOG_LEVEL=
DELUGE_WEB_LOG_LEVEL=

PROWLARR_DB_PASSWORD=

# Read by scripts/cleanup_deluge.sh, not by the containers
SONARR_API_KEY=
RADARR_API_KEY=
