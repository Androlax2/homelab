# qBittorrent's VPN (binhex/arch-qbittorrentvpn): see the image's documentation for accepted values
VPN_ENABLED=
VPN_USER=
VPN_PASS=
VPN_PROV=
VPN_CLIENT=
VPN_OPTIONS=
STRICT_PORT_FORWARD=
ENABLE_PRIVOXY=
# LAN range allowed to reach qBittorrent outside the VPN, e.g. 192.168.1.0/24
LAN_NETWORK=
# Comma-separated DNS servers used inside the VPN container, e.g. 1.1.1.1,9.9.9.9
NAME_SERVERS=
# qBittorrent's web UI login, read by scripts/cleanup_qbittorrent.sh
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

PROWLARR_DB_PASSWORD=

# Read by the recyclarr container and by scripts/cleanup_qbittorrent.sh
SONARR_API_KEY=
RADARR_API_KEY=
