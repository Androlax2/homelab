# VPN of the torrent clients (binhex/arch-delugevpn, binhex/arch-qbittorrentvpn): see the images'
# documentation for accepted values
VPN_ENABLED=
VPN_USER=
VPN_PASS=
VPN_PROV=
VPN_CLIENT=
VPN_OPTIONS=
STRICT_PORT_FORWARD=
ENABLE_PRIVOXY=
# LAN range allowed to reach the torrent clients outside the VPN, e.g. 192.168.1.0/24
LAN_NETWORK=
# Comma-separated DNS servers used inside the VPN container, e.g. 1.1.1.1,9.9.9.9
NAME_SERVERS=
DELUGE_DAEMON_LOG_LEVEL=
DELUGE_WEB_LOG_LEVEL=

PROWLARR_DB_PASSWORD=

# Read by the configarr container and by scripts/cleanup_deluge.sh
SONARR_API_KEY=
RADARR_API_KEY=
