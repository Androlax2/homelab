# Password of Synapse's Postgres database. The first deploy generates it
# (operations/2026_10_10_153832_prepare_the_matrix_stack.before.sh) and also writes it in
# ${DOCKERCONFDIR}/matrix/synapse/local.yaml, where Synapse reads it. Postgres only takes it
# when it creates the database: changing it here alone changes nothing, and changing it in
# local.yaml alone locks Synapse out. Required.
SYNAPSE_DB_PASSWORD=
