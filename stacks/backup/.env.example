# restic repository on the Hetzner Storage Box: "storagebox" is the Host defined in
# ${DOCKERCONFDIR}/restic/ssh/config. Write the path without a leading slash, e.g.
# sftp:storagebox:restic/jeancloud: it is then relative to the box's home folder, which is
# /home on port 23 (and / on port 22), so an absolute /restic/... would point outside it.
RESTIC_REPOSITORY=
# Encrypts the backup. Without it nothing can be restored: keep a copy outside the NAS,
# not in Vaultwarden, which runs on it. Single-quote it if it contains $ signs.
RESTIC_PASSWORD=
# Host folder holding the DSM home folders, e.g. /volume1/homes
HOMESDIR=
